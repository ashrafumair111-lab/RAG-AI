# ══════════════════════════════════════════════════════════════════
#  RAGent — environment template
#  Copy this file to `.env` and fill in your own keys.
#  WARNING: `.env` is git-ignored — never commit real secrets.
# ══════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────
# Port for the Express backend
PORT=5000

# ── Groq — LLM (routing + generation) ─────────────────────────────
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
# Optional second key for fallback / load-balancing
GROQ_API_KEY2=

# ── Tavily — live web search ──────────────────────────────────────
# Get a key: https://app.tavily.com/
TAVILY_API_KEY=your_tavily_api_key

# ── Cohere — embeddings + reranking ───────────────────────────────
# Get a key: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key

# ── Qdrant — vector database ──────────────────────────────────────
# Qdrant Cloud: https://cloud.qdrant.io/
# NOTE: the collection "ragent_docs" is created automatically on first use.
QDRANT_URL=https://your-cluster-url.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# ── MongoDB — sessions & chat history ─────────────────────────────
# MongoDB Atlas: https://www.mongodb.com/atlas
MONGODB_URL=mongodb+srv://user:password@cluster0.example.mongodb.net
# The legacy key name `Mongodb_url` is also supported by the code:
# Mongodb_url=mongodb://localhost:27017